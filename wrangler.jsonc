// Worker "orbita": ospita il Durable Object "Fair" (classifica e tempo reale).
// Le pagine pubbliche sono su Cloudflare Pages: https://orbita-arcade.pages.dev (vedi pages/).
// L'indirizzo workers.dev è spento: si entra solo da Pages.
// Deploy di tutto: `npm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbita",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "FAIR", "class_name": "Fair" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Fair"] }],
  "vars": {
    "SCHOOL": "ITI G. Marconi · Dalmine",
    "COURSE": "Informatica e Telecomunicazioni",
    "QR_URL": "https://www.itisdalmine.edu.it",
    "QR_LABEL": "Scopri il Marconi"
  },
  "observability": { "enabled": true }
}
